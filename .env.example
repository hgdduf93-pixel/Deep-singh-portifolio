# Example Environment Configuration (DO NOT COMMIT REAL SECRETS)
# Copy this file to .env for local development:
# cp .env.example .env

# Server Configuration
PORT=3000

# Database Configuration (if using backend database)
# Placeholder format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# Client-side Configuration (Vite)
VITE_CONTACT_EMAIL=contact@example.com
VITE_API_URL=/api
